spring.application.name=workflow-service

spring.rabbitmq.host=${RABBITMQ_HOST:localhost}
spring.rabbitmq.port=${RABBITMQ_PORT:5672}
spring.rabbitmq.username=${RABBITMQ_USERNAME:forgeflow}
spring.rabbitmq.password=${RABBITMQ_PASSWORD:forgeflow}
# This process publishes only. The execution-worker consumes.
spring.rabbitmq.listener.simple.auto-startup=false

forgeflow.rabbit.exchange=workflow.exchange
forgeflow.rabbit.queue=workflow.jobs
forgeflow.rabbit.routing-key=workflow.job
forgeflow.rabbit.dead-letter-exchange=workflow.dlx
forgeflow.rabbit.dead-letter-queue=workflow.jobs.dlq
forgeflow.rabbit.dead-letter-routing-key=workflow.job.dlq

management.endpoints.web.exposure.include=health
management.endpoint.health.show-details=always
logging.pattern.console=%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p [%X{jobId:--}] %logger{36} : %m%n

spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/forgeflow}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:forgeflow}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:forgeflow}
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.show-sql=true
spring.flyway.enabled=true

spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}
forgeflow.idempotency.ttl-hours=24
forgeflow.cache.workflow-ttl=10m

# Set your key locally. Do not commit real keys. Docker/AWS: GROQ_API_KEY env.
forgeflow.ai.groq.api-key=${GROQ_API_KEY:}
forgeflow.ai.groq.model=openai/gpt-oss-20b
forgeflow.ai.groq.base-url=https://api.groq.com/openai/v1
forgeflow.ai.groq.connect-timeout=3s
forgeflow.ai.groq.read-timeout=10s
